# Netlify / Cloudflare Pages header rules. Inert on hosts that do not read this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Content is fingerprint-free, so it revalidates rather than caching forever.
/
  Cache-Control: public, max-age=0, must-revalidate

# Immutable media. Change the filename to bust these.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=604800, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
